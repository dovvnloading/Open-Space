 physical unit of field                         TTYPE5  = 'LOCALG  '           / Location algorithm used in calculation         TFORM5  = '1I      '           / data format of field: 2-byte INTEGER           TTYPE6  = 'EVTCLASS'           / Two highest probable event classes             TFORM6  = '2I      '           / data format of field: 2-byte INTEGER           TTYPE7  = 'RELIABLT'           / Reliabilities of probable event classes        TFORM7  = '2E      '           / data format of field: 4-byte REAL              TTYPE8  = 'INTNSITY'           / Standardized count intensity                   TFORM8  = '1E      '           / data format of field: 4-byte REAL              TUNIT8  = 'count   '           / physical unit of field                         TTYPE9  = 'HDRATIO '           / Standard hardness ratio (channels 3 / 4)       TFORM9  = '1E      '           / data format of field: 4-byte REAL              TTYPE10 = 'FLUENCE '           / Fluence counts in 3 + 4 energy band            TFORM10 = '1E      '           / data format of field: 4-byte REAL              TUNIT10 = 'count   '           / physical unit of field                         TTYPE11 = 'SIGMA   '           / Significance of localization in sigma          TFORM11 = '1E      '           / data format of field: 4-byte REAL              TTYPE12 = 'LOCRATES'           / Localization rates-12 NaI detectors            TFORM12 = '12I     '           / data format of field: 2-byte INTEGER           TUNIT12 = 'count/s '           / physical unit of field                         TTYPE13 = 'TRIG_TS '           / Location data timescale                        TFORM13 = '1E      '           / data format of field: 4-byte REAL              TUNIT13 = 's       '           / physical unit of field                         TTYPE14 = 'TR_SCAZ '           / Source azimuth with respect to Spacecraft      TFORM14 = '1E      '           / data format of field: 4-byte REAL              TUNIT14 = 'degree  '           /