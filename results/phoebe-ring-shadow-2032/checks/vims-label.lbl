MAXIMUM_OBSERVED_RING_AZIMUTH   =  310.774
LOWEST_DETECTABLE_OPACITY       =   0.0007
HIGHEST_DETECTABLE_OPACITY      =   3.1880

OBJECT                        = SERIES
  NAME                        = "OCCULTATION PROFILE"
  INTERCHANGE_FORMAT          = ASCII
  COLUMNS                     = 14
  ROWS                        = 7890
  ROW_BYTES                   = 142
  SAMPLING_PARAMETER_NAME     = "RING RADIUS"
  SAMPLING_PARAMETER_UNIT     = "KILOMETER"
  MINIMUM_SAMPLING_PARAMETER  =  66110.0
  MAXIMUM_SAMPLING_PARAMETER  = 145000.0
  SAMPLING_PARAMETER_INTERVAL = 10.000000

  DESCRIPTION                 = "This is a radial profile of
  the ring system of Saturn generated from a Cassini VIMS
  stellar occultation. The raw data has been binned to a  
  uniform radial scale, and used to generate values of normal 
  optical depth profiles.
  The DATA_QUALITY_SCORE given above, has values of GOOD, FAIR,
  or POOR. More detailed assessments are provided in 
  VIMS_ring_occultations_summary.pdf in the document 
  directory of this dataset.
  The process to produce the radial profiles includes removing 
  a constant instrumental thermal background (BACKGROUND MODEL). 
  The star signal is assumed to remain constant at the level given as 
  UNOCCULTED STAR MODEL. 
  In a few observations we have determined that one or the 
  other of these is not constant. Those observations are 
  identified using the note flag in the data table. It is 
  possible that these issues may affect other observations 
  as well. Details concerning the production of this profile 
  can be found in VIMS-occultation-processing.txt in the 
  document directory of this dataset and in NICHOLSONETAL2019."

  OBJECT                      = COLUMN
    NAME                      = "RING RADIUS"
    COLUMN_NUMBER             = 1
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 1
    BYTES                     = 8
    FORMAT                    = "F8.1"
    UNIT                      = "KILOMETER"
    DESCRIPTION               = "Radial distance from the 
    center of Saturn to the ring-plane intercept point at 
    the RING EVENT TDB."
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    NAME                      = "RING LONGITUDE"
    COLUMN_NUMBER             = 2
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 10
    BYTES                     = 9
    FORMAT                    = "F9.3"
    UNIT                      = "DEGREE"
    DESCRIPTION               = "Inertial longitude on the 
    ring plane of the ring-plane intercept point at the 
    RING EVENT TIME."
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    NAME                      = "OBSERVED RING AZIMUTH"
    COLUMN_NUMBER             = 3
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 20
    BYTES                     = 9
    FORMAT                    = "F9.3"
    UNIT                      = "DEGREE"
    DESCRIPTION               = "Measured at the ring-plane 
    intercept point, starting from the direction of a 
    photon heading to the observer, and ending at the 
    direction of a local radial vector. This angle is 
    projected into the ring plane and measured in the
    prograde direction. As seen from the observer, it 
    equals 90 degrees along the right ansa and 270 degrees 
    along the left ansa. Values range from 0 to 360 
    degrees."
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    NAME                      = "NORMAL OPTICAL DEPTH"
    COLUMN_NUMBER             = 4
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 30
    BYTES                     = 9
    FORMAT                    = "F9.4"
    INVALID_CONSTANT          = -9.999
    UNIT                      = "N/A"
    DESCRIPTION               = "Estimate of the 
    mean normal optical depth for a band of ring material 
    centered at the given radius. For unconstrained 
    segments of the data, this value is set to -9.999."
  END_OBJECT                  = COLUMN

 OBJECT                      = COLUMN
    NAME                      = "MAXIMUM DETECTABLE NORMAL OPTICAL DEPTH"
    COLUMN_NUMBER             = 5
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 40
    BYTES                     = 9
    FORMAT                    = "F9.4"
    INVALID_CONSTANT          = -9.999
    UNIT                      = "N/A"
    DESCRIPTION               = "Estimate of the maximum 
    detectable mean normal optical depth for a band of ring 
    material centered at the given radius. Computed from 
    the three sigma mean signal uncertainty. For 
    unconstrained segments of the data, this value is 
    set to -9.999."
  END_OBJECT                  = COLUMN


 OBJECT                      = COLUMN
    NAME                      = "MINIMUM DETECTABLE NORMAL OPTICAL DEPTH"
    COLUMN_NUMBER             = 6
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 50
    BYTES                     = 9
    FORMAT                    = "F9.4"
    INVALID_CONSTANT          = -9.999
    UNIT                      = "N/A"
    DESCRIPTION               = "Estimate of the minimum  
    detectable mean normal optical depth for a band of ring 
    material centered at the given radius. Computed from 
    the three sigma mean signal uncertainty. For 
    unconstrained segments of the data, this value 
    is set to -9.999."
  END_OBJECT                  = COLUMN


  OBJECT                      = COLUMN
    NAME                      = "MEAN SIGNAL"
    COLUMN_NUMBER             = 7
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 60
    BYTES                     = 8
    FORMAT                    = "F8.2"
    INVALID_CONSTANT          = -9.999
    UNIT                      = "N/A"
    DESCRIPTION               = "Mean data number returned by
    the instrument at this radial location, with a 
    constant background level removed.  Negative values
    of the signal may result from a misestimation of the
    background signal. For unconstrained segments of the 
    data, this value is set to -9.999."
  END_OBJECT                  = COLUMN
 

 OBJECT                      = COLUMN
    NAME                      = "MEAN SIGNAL UNCERTAINTY"
    COLUMN_NUMBER             = 8
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 69
    BYTES                     = 8
    FORMAT                    = "F8.2"
    INVALID_CONSTANT          = -9.999
    UNIT                      = "N/A"
    DESCRIPTION               = "Estimate of the one-sigma
    uncertainty in the mean signal centered at the given radius, 
    computed based on the number of samples per bin.
    For unconstrained segments of the data, this value is set
    to -9.999."
  END_OBJECT                  = COLUMN


  OBJECT                      = COLUMN
    NAME                      = "OBSERVED EVENT TDB"
    COLUMN_NUMBER             = 9
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 78
    BYTES                     = 16
    FORMAT                    = "D16.3"
    UNIT                      = "SECOND"

    DESCRIPTION               = "The instant at which 
    photons were received at the spacecraft. It is 
    represented in the `Barycentric Dynamical Time' system, 
    as a number of elapsed seconds since the
    J2000 epoch."
  END_OBJECT                  = COLUMN


  OBJECT                      = COLUMN
    NAME                      = "RING EVENT TDB"
    COLUMN_NUMBER             = 10
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 95
    BYTES                     = 16
    FORMAT                    = "D16.3"
    UNIT                      = "SECOND"
    DESCRIPTION               = "The time at which photons 
    left the ring plane. This time is earlier than the 
    associated OBSERVED EVENT TDB by an amount equal to the 
    light travel time. It is represented in the 
    `Barycentric Dynamical Time' system, as a number of 
    elapsed seconds since the J2000 epoch."
  END_OBJECT                  = COLUMN


 OBJECT                      = COLUMN
    NAME                      = "BACKGROUND MODEL"
    COLUMN_NUMBER             = 11
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 112
    BYTES                     = 8
    FORMAT                    = "F8.2"
    UNIT                      = "N/A"
    DESCRIPTION               = "Average 
    instrumental thermal background level 
    subtracted from the signal profile."
  END_OBJECT                  = COLUMN


 OBJECT                      = COLUMN
    NAME                      = "UNOCCULTED STAR MODEL"
    COLUMN_NUMBER             = 12
    DATA_TYPE                 = ASCII_REAL
    START_BYTE                = 121
    BYTES                     = 8
    FORMAT                    = "F8.2"
    UNIT                      = "N/A"
    DESCRIPTION               = "Assumed signal 
    level of the unocculted star."
  END_OBJECT                  = COLUMN


 OBJECT                      = COLUMN
    NAME                      = "NUMBER OF SAMPLES PER BIN"
    COLUMN_NUMBER             = 13
    DATA_TYPE                 = INTEGER
    START_BYTE                = 130
    BYTES                     = 6
    FORMAT                    = "I6"
    UNIT                      = "N/A"
    DESCRIPTION               = "Number of raw measurement
    samples averaged into the given bin. If zero, then the
    signal values are interpolated from adjacent bins."
  END_OBJECT                  = COLUMN

  OBJECT                      = COLUMN
    NAME                      = "NOTE FLAG"
    COLUMN_NUMBER             = 14
    DATA_TYPE                 = INTEGER
    START_BYTE                = 137
    BYTES                     = 4
    FORMAT                    = "I4"
    UNIT                      = "N/A"
    DESCRIPTION               = "A numerical flag which associates
    specific comments with individual radial bins. When 
    more than one comment applies, the values are summed. 
    The values and their associated comments are:

        1 = Maximum optical depth used in place of 
                real optical depth
        2 = Data interpolated instead of binned
        4 = Background model may be incorrect (either 
              too high or too low). Set if B ring residual 
              more than 2 DN from 0, or rms var'ns are excessive
        8 = Unocculted stellar flux level is unstable 
              or otherwise variable. Set if variations 
              outside rings are more than 2%, or there are
              monotonic variations in the 
              unocculted stellar flux.

    "

  END_OBJECT                  = COLUMN
END_OBJECT                    = SERIES
END


