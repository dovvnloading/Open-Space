SELECT d.targetid, d.source_id, d.vrad, d.vrad_err, d.sn_r, d.sn_b, d.sn_z, d.teff,d.logg,d.feh,d.rr_z,d.program,d.survey,d.healpix,d.glon,d.glat,d.target_ra,d.target_dec,
 g.ra,g.dec,g.ra_error,g.dec_error,g.parallax,g.parallax_error,g.pmra,g.pmra_error,g.pmdec,g.pmdec_error,g.ruwe,g.radial_velocity,g.radial_velocity_error,g.phot_g_mean_mag,g.astrometric_params_solved,g.nu_eff_used_in_astrometry,g.pseudocolour,g.ecl_lat,g.ra_dec_corr,g.ra_parallax_corr,g.ra_pmra_corr,g.ra_pmdec_corr,g.dec_parallax_corr,g.dec_pmra_corr,g.dec_pmdec_corr,g.parallax_pmra_corr,g.parallax_pmdec_corr,g.pmra_pmdec_corr,g.visibility_periods_used,g.duplicated_source FROM desi_dr1.mws AS d JOIN gaia_dr3.gaia_source AS g ON d.source_id=g.source_id WHERE d.rvs_warn=0 AND d.vrad_err>0 AND d.vrad_err<20 AND d.rr_spectype='STAR' AND ABS(d.vrad-299792.458*d.rr_z)<60 AND d.source_id>999999 AND ABS(d.vrad+11.1*COS(RADIANS(d.glon))*COS(RADIANS(d.glat))+245.6*SIN(RADIANS(d.glon))*COS(RADIANS(d.glat))+7.25*SIN(RADIANS(d.glat)))>500
