SELECT n.source_id, n.nss_solution_type,n.period,n.period_error,n.eccentricity,n.significance,n.goodness_of_fit,e.frequency,e.global_ranking,s.ra,s.dec,s.phot_g_mean_mag FROM gaiadr3.nss_two_body_orbit AS n JOIN gaiadr3.vari_eclipsing_binary AS e ON n.source_id=e.source_id JOIN gaiadr3.gaia_source AS s ON n.source_id=s.source_id WHERE n.nss_solution_type IN ('Orbital','AstroSpectroSB1') AND n.period*e.frequency>10 AND e.global_ranking>0.4
