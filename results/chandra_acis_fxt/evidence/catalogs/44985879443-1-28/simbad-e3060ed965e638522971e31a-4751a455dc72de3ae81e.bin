<FIELD arraysize="*" datatype="char" name="main_id" ucd="meta.id;meta.main" utype="mango:MangoObject.identifier">
<DESCRIPTION>Main identifier for an object</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="ra" ucd="pos.eq.ra;meta.main" unit="deg" utype="mango:EpochPosition.longitude[CS.spaceSys=ICRS CT.epoch=J2000]">
<DESCRIPTION>Right ascension</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="dec" ucd="pos.eq.dec;meta.main" unit="deg" utype="mango:EpochPosition.latitude[CS.spaceSys=ICRS CT.epoch=J2000]">
<DESCRIPTION>Declination</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="otype" ucd="src.class" utype="mango:Label.text[CT.vocabulary=https://www.ivoa.net/rdf/uat#classification]">
<DESCRIPTION>Object type</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="rvz_redshift" ucd="src.redshift">
<DESCRIPTION>redshift</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="coo_err_maj" ucd="phys.angSize.smajAxis;pos.errorEllipse;pos.eq" unit="mas" utype="mango:EpochPosition.errors.position/mango:error.PErrorEllipse.semiMajorAxis[CS.spaceSys=ICRS CT.epoch=J2000]">
<DESCRIPTION>Coordinate error major axis</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="path">
<DESCRIPTION>Otype path in the hierarchical classification</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="is_candidate">
<DESCRIPTION>True if the object type is a candidate (non-confirmed)</DESCRIPTION>
<VALUES null='-32768'/>
</FIELD>
