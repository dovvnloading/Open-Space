    <GROUP name="inputParams">
        <PARAM name="ID"  datatype="long"  value="" ref="SOURCE_ID"/>
        <PARAM name="RELEASE" datatype="char" arraysize="*" value="Gaia DR3"/>
    </GROUP>
</RESOURCE>
