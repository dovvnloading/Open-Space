<INFO name="PROVIDER" value="CDS">SIMBAD TAP Service</INFO>
<INFO name="QUERY" value="SELECT b.main_id,b.ra,b.dec,b.otype,b.rvz_redshift,b.coo_err_maj,t.path,t.is_candidate FROM basic AS b LEFT OUTER JOIN otypedef AS t ON b.otype=t.otype WHERE CONTAINS(POINT('ICRS',b.ra,b.dec),CIRCLE('ICRS',290.3083333333,43.9916666667,0.0394444444))=1"/>
