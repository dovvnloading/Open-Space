<RESOURCE type="results">

<INFO name="JOBID" value="e2cbd5cf-e648-11f1-88af-bc97e148b76b-O" ucd="meta.id;meta.query"/>
<INFO name="JOBNAME" value=""/>
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT source_id,ra,dec,ref_epoch,pmra,pmdec,pmra_error,pmdec_error,ra_error,dec_error,parallax,parallax_error,ruwe,phot_g_mean_mag FROM gaiadr3.gaia_source WHERE CONTAINS(POINT(&#039;ICRS&#039;,ra,dec),CIRCLE(&#039;ICRS&#039;,38.0333333333,-21.2916666667,0.0727777778))=1" ucd="meta.query"/>

