      </FIELD>
      <FIELD name="w4mpro" datatype="float" ID="col_11" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 4</DESCRIPTION>
      </FIELD>
