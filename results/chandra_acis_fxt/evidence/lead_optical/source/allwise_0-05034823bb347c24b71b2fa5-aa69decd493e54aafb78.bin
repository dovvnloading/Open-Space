        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 2</DESCRIPTION>
      </FIELD>
      <FIELD name="w3mpro" datatype="float" ID="col_9" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 3</DESCRIPTION>
      </FIELD>
      <FIELD name="w3sigmpro" datatype="float" ID="col_10" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 3</DESCRIPTION>
      </FIELD>
      <FIELD name="w4mpro" datatype="float" ID="col_11" irsa_format="7.3f" precision="F3" ucd="phot.mag" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry magnitude, band 4</DESCRIPTION>
      </FIELD>
      <FIELD name="w4sigmpro" datatype="float" ID="col_12" irsa_format="5.3f" precision="F3" ucd="stat.error" unit="mag">
        <DESCRIPTION>instrumental profile-fit photometry flux uncertainty in mag units, band 4</DESCRIPTION>
      </FIELD>
      <FIELD name="w1snr" datatype="double" ID="col_13" irsa_format="8.1f" precision="F1" ucd="stat.snr">
        <DESCRIPTION>instrumental profile-fit photometry S/N ratio, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w2snr" datatype="double" ID="col_14" irsa_format="8.1f" precision="F1" ucd="stat.snr">
        <DESCRIPTION>instrumental profile-fit photometry S/N ratio, band 2</DESCRIPTION>
      </FIELD>
      <FIELD name="w3snr" datatype="double" ID="col_15" irsa_format="8.1f" precision="F1" ucd="stat.snr">
        <DESCRIPTION>instrumental profile-fit photometry S/N ratio, band 3</DESCRIPTION>
      </FIELD>
      <FIELD name="w4snr" datatype="double" ID="col_16" irsa_format="8.1f" precision="F1" ucd="stat.snr">
