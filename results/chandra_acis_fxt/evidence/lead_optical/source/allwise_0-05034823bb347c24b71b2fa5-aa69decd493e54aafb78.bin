      </FIELD>
      <FIELD name="ext_flg" datatype="long" ID="col_19" ucd="stat.probability">
        <DESCRIPTION>probability that source morphology is not consistent with single PSF</DESCRIPTION>
      </FIELD>
      <FIELD name="nb" datatype="long" ID="col_20" ucd="meta.number;stat.fit.param">
