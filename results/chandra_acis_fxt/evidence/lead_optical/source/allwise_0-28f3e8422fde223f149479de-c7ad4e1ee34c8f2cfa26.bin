      </FIELD>
      <FIELD name="w1snr" datatype="double" ID="col_13" irsa_format="8.1f" precision="F1" ucd="stat.snr">
        <DESCRIPTION>instrumental profile-fit photometry S/N ratio, band 1</DESCRIPTION>
      </FIELD>
      <FIELD name="w2snr" datatype="double" ID="col_14" irsa_format="8.1f" precision="F1" ucd="stat.snr">
