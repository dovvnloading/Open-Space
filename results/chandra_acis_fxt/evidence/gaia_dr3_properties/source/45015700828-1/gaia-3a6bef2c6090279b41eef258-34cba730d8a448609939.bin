<INFO name="QUERY" value="SELECT source_id,solution_id,phot_g_mean_mag,bp_rp,parallax,parallax_error,pmra,pmra_error,pmdec,pmdec_error,astrometric_params_solved,ruwe,visibility_periods_used,astrometric_excess_noise,duplicated_source,phot_variable_flag,has_epoch_photometry,has_xp_continuous,has_xp_sampled,has_rvs,has_mcmc_gspphot,in_qso_candidates,in_galaxy_candidates,libname_gspphot,classprob_dsc_combmod_star,classprob_dsc_combmod_galaxy,classprob_dsc_combmod_quasar,teff_gspphot,teff_gspphot_lower,teff_gspphot_upper,logg_gspphot,logg_gspphot_lower,logg_gspphot_upper,mh_gspphot,mh_gspphot_lower,mh_gspphot_upper,distance_gspphot,distance_gspphot_lower,distance_gspphot_upper,azero_gspphot,azero_gspphot_lower,azero_gspphot_upper,ag_gspphot,ag_gspphot_lower,ag_gspphot_upper,ebpminrp_gspphot,ebpminrp_gspphot_lower,ebpminrp_gspphot_upper FROM gaiadr3.gaia_source WHERE source_id IN (4658285520288055296,4658285520288442624,4658285520288444032,4658285520288444672,4658285524581951360,4661810348413722112,4690512893287832320,5272298786517415168,5322862100769721856,5322865674182434688,5337186503924630656,5337960388293723520,5337960388322765056,5338050062894096512,5350363394865772544,5350387549750520832,5350387584109350272,5525063491699423104,5882797399489052032,5939645032540529280,5939645036848499456,5939655928892340352,5939670871062038528,5940105281232821760,5940200358923266944,5940200358928922240,5943109151297695488,5943109151323765504,5970177714528265728,5973629807372214784,6472245441370087808,6731196617449019392,6731200706257840384,6897888898111908864)" ucd="meta.query"/>

