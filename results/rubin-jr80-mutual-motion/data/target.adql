SELECT l.oid,l.measurement_id,l.visit,l.detector,l.snr,l.psfflux,l.psffluxerr,l.apflux,l.apfluxerr,l.trailflux,l.traillength,l.trailangle,l.ixx,l.iyy,l.ixy,l.ixxpsf,l.iyypsf,l.ixypsf,l.extendedness,l.reliability,l.created_date,l.isdipole,l.psfflux_flag,l.apflux_flag,l.shape_flag,l.pixelflags_bad,l.pixelflags_saturatedcenter,l.exposuretime,l.trail_flag,l.pixelflags,l.pixelflags_suspectcenter,l.pixelflags_interpolatedcenter,l.pixelflags_saturated,l.pixelflags_crcenter,l.pixelflags_edge,l.pixelflags_nodatacenter,l.apflux_flag_aperturetruncated,l.pixelflags_streak,l.pixelflags_streakcenter,d.mjd,d.band,d.ra,d.dec,s.designation,s.ephra,s.ephdec,s.ephrate,s.phaseangle,s.ephoffset,s.heliorange,s.ephratera,s.ephratedec,s.helio_x,s.helio_y,s.helio_z,s.helio_vx,s.helio_vy,s.helio_vz,s.topo_x,s.topo_y,s.topo_z,s.topo_vx,s.topo_vy,s.topo_vz,s.toporange FROM alerce_tap.lsst_detection AS l JOIN alerce_tap.detection AS d ON d.measurement_id=l.measurement_id AND d.sid=l.sid AND d.oid=l.oid JOIN alerce_tap.lsst_ss_detection AS s ON s.measurement_id=l.measurement_id AND s.ssobjectid=l.oid WHERE l.sid=2 AND l.oid=21164723906555986 ORDER BY d.mjd
