SELECT l.oid,l.visit,l.detector,l.measurement_id,l.snr,l.psfflux,l.apflux,l.ixx,l.iyy,l.ixy,l.ixxpsf,l.iyypsf,l.ixypsf,l.x,l.y,l.trailangle,l.traillength FROM alerce_tap.lsst_detection AS l WHERE l.sid=2 AND l.reliability>0.9 AND l.snr>7 AND l.isdipole='f' AND l.psfflux_flag='f' AND l.apflux_flag='f' AND l.shape_flag='f' AND l.pixelflags_bad='f' AND l.pixelflags_saturatedcenter='f' AND l.pixelflags='f' AND l.pixelflags_suspectcenter='f' AND l.pixelflags_interpolatedcenter='f' AND l.pixelflags_crcenter='f' AND l.pixelflags_edge='f' AND l.pixelflags_nodatacenter='f' AND l.apflux_flag_aperturetruncated='f' AND l.pixelflags_streakcenter='f' AND l.visit IN (2026062600699,2026062600751,2026070600713,2026070600765,2026070800281) ORDER BY l.visit,l.measurement_id
