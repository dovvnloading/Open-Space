<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT source_id
FROM gaiadr3.gaia_source
WHERE pm &gt; 35
AND bp_rp &lt; 1.2
AND parallax_over_error &gt; 3
AND 4.74047 * pm &gt; 1000 * parallax
AND phot_g_mean_mag + 5 * LOG10(parallax) - 10 &gt; 3.5" ucd="meta.query"/>

