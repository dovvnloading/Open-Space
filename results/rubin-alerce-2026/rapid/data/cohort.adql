SELECT TOP 1500 o.oid,o.meanra,o.meandec,o.n_det,o.n_forced,o.firstmjd,o.lastmjd,x.dist,g.oid_catalog,g.bp_rp,g.phot_g_mean_mag,g.parallax,g.ruwe FROM alerce_tap.object AS o JOIN alerce_tap.xmatch AS x ON o.oid=x.oid AND o.sid=x.sid JOIN alerce_tap.gaiadr3_source AS g ON g.oid_catalog=x.oid_catalog WHERE o.sid=1 AND x.catid=1 AND x.dist<0.8 AND o.n_det>=10 AND o.n_forced>=30 AND g.bp_rp<0.25 AND g.phot_g_mean_mag>16
